rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Günün Sorusu oyuncuları =====
    match /players/{playerId} {
      // Okuma YALNIZCA dokümanın sahibine. Liderlik verisi, servis hesabıyla
      // çalışan /api/leaderboard (Netlify function) tarafından üretilir; o
      // kuralları baypas ettiği için public read'e GEREK YOK. Eskiden
      // "allow read: if true" idi ve tüm oyuncuların uid+ad+gün-gün OYUN GEÇMİŞİ
      // dünyaya açıktı (gizlilik sızıntısı + koleksiyonu döngüyle okuyup
      // okuma kotasını yakma vektörü). Kapatıldı.
      allow read: if request.auth != null && request.auth.uid == playerId;

      // ---- Alan doğrulama (tip + aralık). create ve update'te ortak. ----
      // name zorunlu string; sayısal alanlar zorunlu sayı + makul aralık:
      // string XSS payload'ı ve absürt değerler (bestStreak:99999) reddedilir.
      // history bir map ve <=4000 gün (doküman şişirme / depolama kotası koruması).
      function validPlayer(d) {
        return d.name is string && d.name.size() <= 20
          && (!('bestStreak' in d) || (d.bestStreak is number && d.bestStreak >= 0 && d.bestStreak <= 3650))
          && (!('streak' in d)     || (d.streak is number     && d.streak >= 0     && d.streak <= 3650))
          && (!('avgTries' in d)   || (d.avgTries is number   && d.avgTries >= 1    && d.avgTries <= 5))
          && (!('eligible' in d)   || d.eligible is bool)
          && (!('totalDays' in d)  || (d.totalDays is number  && d.totalDays >= 0   && d.totalDays <= 4000))
          && (!('history' in d)    || (d.history is map       && d.history.size() <= 4000));
      }

      // ---- Tutarlılık (anti-hile). Stat alanları birbiriyle uyumlu olmalı. ----
      // İstemci HER ZAMAN şunları sağlar (computeStats):
      //   totalDays == history.size()  ·  bestStreak/streak <= totalDays
      //   eligible == (totalDays >= 10)
      // Böylece "hiç oynamadan bestStreak:3650, eligible:true" yazmak için artık
      // 3650 girişli sahte bir history map'i kurmak gerekir (tek int yetmez).
      // Tam koruma değil (Spark'ta sunucu-taraflı hesap yok) ama bariz hileyi zorlaştırır.
      function statsConsistent(d) {
        return (!('totalDays' in d)  || !('history' in d)   || d.totalDays == d.history.size())
          && (!('bestStreak' in d)   || !('totalDays' in d) || d.bestStreak <= d.totalDays)
          && (!('streak' in d)       || !('totalDays' in d) || d.streak <= d.totalDays)
          && (!('eligible' in d)     || !('totalDays' in d) || d.eligible == (d.totalDays >= 10));
      }

      // create: yeni doküman — tüm alanlar yeni, tam tutarlılık uygulanır.
      allow create: if request.auth != null && request.auth.uid == playerId
        && validPlayer(request.resource.data)
        && statsConsistent(request.resource.data);

      // update: tutarlılık YALNIZCA stat alanları değişirken uygulanır. Böylece
      // "İsmi düzenle" (yalnız name'i değiştiren merge write) tutarlılık kontrolüne
      // TAKILMAZ — eski/efsanevi dokümanlarda bile isim düzenleme her zaman çalışır.
      allow update: if request.auth != null && request.auth.uid == playerId
        && validPlayer(request.resource.data)
        && ( !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['totalDays', 'history', 'bestStreak', 'streak', 'eligible'])
             || statsConsistent(request.resource.data) );

      allow delete: if false;
    }

    // ===== Anketler =====
    match /surveys/{surveyId} {
      // İsim + kriterler herkese açık okunur (ankete katılmak için gerekli).
      // Gizli anahtar artık YOK; hassas veri (cevaplar) responses altında kilitli.
      allow read: if true;

      // Oluşturma: kimlik ZORUNLU (anonim de olsa) — kimliksiz curl/script yazımı
      // kapatıldı. owner ya boş (anonim kurucu; sonradan Google ile sahiplenir)
      // ya da kendi uid'i. App Check ikinci katman.
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 40
        && request.resource.data.criteria is list
        && request.resource.data.criteria.size() <= 30
        && (request.resource.data.owner == ''
            || request.resource.data.owner == request.auth.uid);

      // Güncelleme SADECE iki senaryoda:
      allow update: if
        // (a) sahiplenme: yalnız 'owner' alanı, boştan -> kendi uid'ine
        ( request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner'])
          && (!('owner' in resource.data) || resource.data.owner == '')
          && request.resource.data.owner == request.auth.uid )
        ||
        // (b) yumuşak silme: yalnız 'deleted', SADECE owner
        ( request.auth != null
          && resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
          && request.resource.data.deleted == true );

      // Sert silme yok, yalnızca yumuşak silme (yukarıda)
      allow delete: if false;

      // ===== Cevaplar (TAM GİZLİLİK) =====
      match /responses/{responseId} {
        // Owner TÜM cevapları okur; katılımcı YALNIZCA kendi cevabını (doc id == uid).
        // Self-read, "bu ankete zaten katıldın + eski sonucun" akışını mümkün kılar;
        // başkasının cevabını göremez (gizlilik korunur).
        allow read: if request.auth != null
          && ( get(/databases/$(database)/documents/surveys/$(surveyId)).data.owner == request.auth.uid
               || responseId == request.auth.uid );
        // Katılımcı cevap yazar. Kimlik ZORUNLU (anonim giriş yeterli): kimliksiz
        // toplu spam yazımı kapatıldı. App Check + alan doğrulama ikinci katman.
        // (İstemci doc id'yi uid yapar → kişi başına tek cevap; update:false mükerreri keser.)
        allow create: if request.auth != null
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 30;
        // Cevap değiştirilemez / silinemez (kişi başına tek, kalıcı cevap)
        allow update, delete: if false;
      }
    }
  }
}
